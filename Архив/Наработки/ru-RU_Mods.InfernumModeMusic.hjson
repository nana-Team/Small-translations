Items: {
	SoulDrivenHeadphones: {
		DisplayName: Душепроводящие наушники
		Tooltip:
			'''
			Позволяет выбирать и проигрывать Infernum-темы побеждённых боссов, а также переключать специальные темы
			Держа их, вы чувствуете отдалённое присутствие чего-то мистического
			Вы также слышите звуки страстной игры инструментов
			'''
	}
}

Projectiles.SoulDrivenHeadphonesProj.DisplayName: Душепроводящие наушники

HeadphonesText: {
	1: Сейчас играет «{0}»!
	2: «{0}» будет играть во время битв с боссами!
}

BossName: {
	# Тире используется как сепаратор в коде для HeadphonesText.1, не менять
	TitleScreen: Sky After Rain - Infernum
	KingSlime: Gelatinous Dynasty - Король слизней
	EyeOfCthulhu: Seer of the Night - Глаз Ктулху
	EaterOfWorlds: Maw of the Corruption - Пожиратель миров
	BrainOfCthulhu: Intellect of the Crimson - Мозг Ктулху
	QueenBee: Royal Retaliation - Королева пчёл
	Skeletron: Warden of the Damned - Скелетрон
	WallOfFlesh: One's Ending, Another's Beginning - Стена плоти
	Minibosses: Misanthropic Encounters - Мини-боссы
	QueenSlime: Crowned before One's End - Королева слизней
	MechBosses: Inferior Fabrications - Механическое трио
	Plantera: Floral Animosity - Плантера
	Golem: Icon of the Sun - Голем
	DukeFishron: Razorblade Typhoon - Герцог Рыброн
	EmpressOfLight: Shining Kaleidoscope - Императрица света
	LunaticCultist: Eidolic Ancestry - Культист-лунатик
	BereftVassal: Duel for a Lost Kingdom - Обездоленный вассал
	MoonLord: The End of an Olden Era - Лунный лорд
	PrimordialWyrm: Vocitus Terminus - Первозданный змий
	ExoMechsOld: Inferior Fabrications (Exo Remix) - Экзо-механизмы
	ExoMechs: Catastrophic Fabrications - Экзо-механизмы
	ExoMechsAlt: Zenith Fabrications - Экзо-механизмы
	Draedon: Their Fabricator - Дрэйдон
	Calamitas: Scars of Calamity - Высшая Каламитас
	StormBeforeDawn: Storm Before Dawn - Infernum
}

