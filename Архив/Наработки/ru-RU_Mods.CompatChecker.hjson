	VerifiedMPCompatibleCount: "{0} {^0:мод, проверенный;мода, проверенных;модов, проверенных} на совместимость с мультиплеером ✓"
	MultiplayerCompatibleMods: "[c/FFFFFF:Моды, совместимые с мультиплеером:]"
