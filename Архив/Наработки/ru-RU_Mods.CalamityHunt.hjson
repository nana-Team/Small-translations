	StickyHand: {
		DisplayName: Рука-лизун
		Tooltip:
			'''
			Автоматически отцепляется от поверхности при приближении к месту захвата
			Удерживайте клавишу крюк-кошки, чтобы крюк не отцеплялся
			'Я уверяю, она не порвётся'
			{$}
			'''
		Stats:
			'''
			Дальность: 56
			Скорость вылета: 25
			Скорость возврата: 10
			Скорость притягивания: 17
			'''
	}

	Trailblazer: {
		# НЕ первопроходец, игра слов с blaze
		DisplayName: Выжигатель
		Tooltip:
			'''
			Использует гель в качестве боеприпасов
			Игнорирует 30 ед. защиты врага
			80% шанс не использовать боеприпасы
			'''
	}

	SlimeCane: {
		DisplayName: Трость слизней
		Tooltip:
			'''
			Призывает команду из 4 слизней-оруженосцев
			Повторные призывы усиливают уже существующих миньонов
			Слизней можно усилить максимум до 4 раз
			Когда слизни будут максимально усилены, призовётся Гизмоем, стреляющий термоядерными лучами во врагов
			'Если бы я только мог очистить его от всей этой грязи, и сделать таким же прекрасным, как я'
			'''
			# Гизмоем - отсылка на покемона Космоем
			# Фраза в конце тултипа - НЕ отылка
	}

	FissionFlyer: {
		DisplayName: Скоростной дезинтегратор
		Tooltip:
			'''
			Бросает чакрам, разделяющийся на 3 бритвенных кольца
			При скрытном ударе чакрам оставляет после себя огромную пилу
			'''
	}

	ScytheOfTheOldGod: {
		# Отсылка на Косу забытого бога
		DisplayName: Коса Старого бога
		Tooltip:
			'''
			Совершает серию из 3 взмахов огромной косой
			'Не путать с косой Старого герцога...
			...и ни с чем другим'
			'''
