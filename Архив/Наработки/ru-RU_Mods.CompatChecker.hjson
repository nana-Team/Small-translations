	ModsUnstableInMultiplayer: "[c/FFFFFF:Моды, нестабильные в мультиплеере:]"
	MPIncompatibleCount: "{0} {^0:мод, несовместимый;мода, несовместимых;модов, несовместимых} с мультиплеером ✘"
	MultiplayerIncompatibleMods: "[c/FFFFFF:Моды, несовместимые с мультиплеером:]"
	PotentialIssuesCount: "{0} {^0:потенциальная проблема;потенциальные проблемы;потенциальных проблем} ❗"
	NoIssues: Проблем не найдено! ✓
	NoChecksEnabled: Проверки не включены — см. конфигурацию
	CheckingMPSupport: "[c/FFFFFF:Проверка] [c/BDB8C4:поддержки мультиплеера]"
	NoDataLocalModsCount: Нет данных для {0} {^0:локального мода;локальных мода;локальных модов} ❓
	LocalMods: "[c/FFFFFF:Локальные моды (не из Мастерской)]"
	RecommendedAddons:
		'''

		  [c/BDB8C4:- Рекомендуемые совместимые аддоны: 
		'''
	RelevantGitHubIssues:
		'''

		  [c/BDB8C4:- Актуальные проблемы с GitHub: 
		'''
	HelpContributeTooltip:
		'''
		Нашли ошибки или пропущена информация? Помогите исправить это!
		[c/7F8CFF:{0}]
		'''
	LeftClickShowTmodFile:
		'''

		[c/BDB8C4:Нажмите ЛКМ, чтобы посмотреть файл .tmod]
		'''
	RightClickOpenModSourceFolder:
		'''

		[c/BDB8C4:Нажмите ПКМ, чтобы открыть папку с исходниками]
		'''
	LeftClickOpenWorkshopPage:
		'''

		[c/BDB8C4:Нажмите ЛКМ, чтобы открыть страницу в Мастерской]
		'''
	DonationTooltip:
		'''
		Поддержите разработчика и помогите моду оставаться живым!
		[c/BDB8C4:Будьте в курсе моих последних проектов и обновлений здесь!]
		[c/BDB8C4:(Вы можете отключить эту подсказку в настройках мода).]
		'''
}
