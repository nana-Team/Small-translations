	Goozmaga: {
		# Отсылка на способности из файнал фентези, Blizzaga
		DisplayName: Гузмага
		Tooltip:
			'''
			Запускает планеты, вращающиеся вокруг поражённых врагов
			Удары по врагам, вокруг которых уже вращается планета, увеличивают её скорость
			Эффект складывается до 8 раз
			При скрытном ударе дополнительно вызывает два меньших планетоида
			Нажмите <right>, чтобы уничтожить все существующие планеты и планетоиды
			'''
	}

	ShogunChestplate: {
		DisplayName: Склизкий нагрудник сёгуна
		Tooltip:
			'''
			Увеличивает урон на 20%
			Увеличивает сопротивление урону на 9% и регенерацию здоровья на 1,5 ед./сек
			Увеличивает максимальный запас здоровья и маны на 150
			'''
	}

	ShogunHelm: {
		DisplayName: Склизкий шлем сёгуна
		Tooltip:
			'''
			Увеличивает урон на 20% и шанс критического удара на 15%
			Увеличивает скорость ближнего боя на 15%
			'''
		SetBonus:
			'''
			Увеличивает максимальное количество миньонов на 5
			Увеличивает максимальную скрытность на 100, когда вы держите разбойное оружие
			{$CommonItemTooltip.FlightAndSlowfall}, если у вас нет других крыльев
			{$CommonItemTooltip.PressDownToHover}
			Позволяет совершать рывок и усиливает другие рывки
			Удерживайте ВНИЗ, когда находитесь в воздухе, чтобы ускорить падение
			Увеличивает скорость прыжка
			Даёт невосприимчивость к отбрасыванию и большинству дебаффов конца игры
			'''
	}

	ShogunPants: {
		DisplayName: Склизкие штаны сёгуна
		Tooltip:
			'''
			Увеличивает урон на 20%
			Увеличивает скорость передвижения на 50%
			Значительно увеличивает ускорение и манёвренность
			'''
	}

	AuricSole: {
