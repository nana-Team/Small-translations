ItemDescriptions: {
	AstralBreastplate: Увеличивает максимальный запас вдохновения на 6 ед. и бонусное исцеление на 4 ед.
	AstralHelm: Увеличивает скорость восстановления вдохновения на 12%
	CelestialCarrier:
		'''
		Горизонтальная скорость: 9.00
		Множитель ускорения: 2.5
		Отличная вертикальная скорость
		Время полёта: 180
		Исцеляющие заклинания восстанавливают дополнительно 4 ед. здоровья, если надет неземной комплект
		'''
	DemonshadeGreaves:
		'''
		Увеличивает максимальное число очков техники на 2 и максимальный запас вдохновения на 15
		Увеличивает бонусное исцеление на 25 ед.
		Увеличивать скорость наведения и дистаницю духовых инструментов на 60%
		Снаряды струнного оружия могут дополнительно отскакивать 6 раз
		Удваивает радиус действия ваших усилений и увеличивает их длительность на 6 секунд
		'''
	DemonshadeHelm:
		'''
		Увеличивает лучезарный и симфонический урон на 30%
		Увеличивает скорость лечения и произнесения лучезарных заклинаний на 35%
		Увеличивает симфоническую скорость игры на инструменте на 35%
		Увеличивает скорость восстановления вдохновения и шанс выпадения нот вдохновения на 55%
		'''
	DemonBloodWings:
		'''
		Горизонтальная скорость: 7.5
		Множитель ускорения: 1.0
		Средняя вертикальная скорость
		Время полёта: 170
		Значительно ускоряет регенерацию здоровья во время ярости, если надет демонический кровавый комплект
		'''
	DragonWings:
		'''
		Горизонтальная скорость: 6.25
		Множитель ускорения: 1.0
		Средняя вертикальная скорость
		Время полёта: 100
		Атаки накладывают дебафф «Проклятое инферно», если надет драконий комплект
		'''
	DreadWings:
		'''
		Горизонтальная скорость: 7.5
		Множитель ускорения: 1.0
		Средняя вертикальная скорость
		Время полёта: 170
		Увеличивает множитель урона от состояния ярости, если надет устрашающий комплект
		'''
	FleshWings:
		'''
		Горизонтальная скорость: 6.25
		Множитель ускорения: 1.0
		Средняя вертикальная скорость
		Время полёта: 100
		Атаки имеют шанс похитить здоровье врага, если надет мясистый комплект
		'''
	OmegaBlueSet:
		'''
		Увеличивает максимальное число очков техники на 2
		Увеличивает максимальный запас вдохновения на 12 ед. и бонусное исцеления на 7 ед.
		'''
	ShootingStarTurboTuba:
		'''
		Горизонтальная скорость: 9.00
		Множитель ускорения: 2.5
		Отличная вертикальная скорость
		Время полёта: 180
		Увеличивает скорость восстановления вдохновения на 15%, если надет комплект падающей звезды
		'''
	TitanWings:
		'''
		Горизонтальная скорость: 7.5
		Множитель ускорения: 1.0
		Средняя вертикальная скорость
		Время полёта: 160
		Увеличивает урон, а также урон класса, соответствующий шлему, на 15%, если надет титанический комплект
		'''
	WhiteDwarfThrusters:
		'''
		Горизонтальная скорость: 9.00
		Множитель ускорения: 2.5
		Отличная вертикальная скорость
		Время полёта: 180
		Метательное оружие изматывает вас на 50% медленнее, если надет комплект белого карлика
		'''
	WulfrumJacket: Увеличивает радиус действия ваших усилений на 25%
}

Items: {
	AerospecBiretta: {
		DisplayName: Аэрофазовая бирретта
		Tooltip:
			'''
			Увеличивает лучезарный урон и скорость лучезарных атак на 7%
			Исцеляющие заклинания восстанавливают дополнительно 2 ед. здоровья
			'''
		SetBonus:
			'''
			
			Увеличивает скорость передвижения на 5%
			Увеличивает лучезарный урон на 13%
			Исцеляющие заклинания восстанавливают дополнительно 3 ед. здоровья, если вы находитесь в воздухе
			'''
	}

	AerospecHeadphones: {
		DisplayName: Аэрофазовые наушники
		Tooltip: Увеличивает симфонический урон и скорость симфонической игры на инструменте на 8%
		SetBonus:
			'''
			
			Увеличивает скорость передвижения и восстановления вдохновления на 5%
			Увеличивает скорость наведения духовых инструментов на 10%
			'''
	}

	AnahitasArpeggio: {
		DisplayName: "{$Mods.CalamityMod.Items.Weapons.Magic.AnahitasArpeggio.DisplayName}"
		Tooltip:
			'''
			{$Mods.CalamityMod.Items.Weapons.Magic.AnahitasArpeggio.Tooltip}
			По мотивам арфы из «Forbidden Lullaby» от DM Dokuro
			'''
	}

	AquaiusAdvice: {
		DisplayName: Завещание Аквауса
		Tooltip:
			'''
			Быстро выпускает извивающиеся щупальца бездны, скручивающиеся в завитки
			Накладывает дебафф «Давление глубин»
			«Погибни в бездне или восстань из неё... как завещал Акваус, Бесконечный прилив»
			'''
	}

	ArcticReinforcement: {
		DisplayName: Арктическое укрытие
		Tooltip:
			'''
			Выпускает мини-снежную бурю из сосулек
			«Северный полярный аналог»
			По мотивам ксилофона из «Antarctic Reinforcement» от DM Dokuro
			'''
	}

	AugmentedAuricTeslaFeatheredHeadwear: {
		DisplayName: Плюмажный ауритовый тесла-головной убор[c/70f4f4:+]
		Tooltip:
			'''
			Увеличивает симфоничесикй урон на 25%
			Увеличивает шанс симфонического критического удара на 20%
			Увеличивает скорость симофнической игры на инструменте на 12%
			Увеличивает скорость наведения и дистаницю духовых инструментов на 20%
			Снаряды струнного оружия могут дополнительно отскакивать 1 раз
			'''
		SetBonus:
			'''
			
			Бонусы от комплектов брони барда: межгалактической, кровавой вспышки и богоубийцы
			Нажатие клавиши бонуса комплекта брони Calamity совершает рывок богоубийцы
			Нажатие клавиши бонуса комплекта брони Thorium использует «Очаровательную песню»
			Увеличивает длительность симфонических усилений на 5 секунд
			Увеличивает скорость восстановления вдохновения на 20%
			Увеличивает шанс выпадения нот вдохновения на 45%
			'''
	}

	AugmentedAuricTeslaValkyrieVisage: {
		DisplayName: Валькирийский ауритовый тесла-лик[c/70f4f4:+]
		Tooltip:
			'''
			Увеличивает лучезарный урон на 15%
			Увеличивает шанс лучезарного критического удара на 10%
			Снижает расход маны на 45%
			Значительно ускореяет регенерацию здоровья и маны
			Увеличивает максимальный запас здоровья на 100 ед.
			Увеличивает максимальный запас маны на 200 ед.
			Исцеляющие заклинания восстанавливают дополнительно 18 ед. здоровья
			'''
		SetBonus:
			'''
			
			Бонусы от комплектов брони целителя: межгалактической, кровавой вспышки и Сильвы
