			Pierces targets but damage gets reduced by a flat amount
			Tunes targets on hit, increasing the damage they take by 5%
			"Behold! The Cheap-Insults-Inator!"
			'''
	}

	WulfrumWeedWacker: {
		DisplayName: Wulfrum Weed Wacker
		Tooltip:
			'''
			This scythe is swung directionally instead of spun
			Shoots a short-ranged wave every swing
			"Wulfrum weed wacker wacking weed with wulfrum"
			'''
	}

	YharimsJam: {
		DisplayName: Yharim's Jam
		Tooltip:
			'''
			930 symphonic damage
			Summons three supersonic speakers that hover beside and below you
			The speakers will shoot burning beats that tracks to the closest enemy
			Inflicts dragonfire and tunes enemies hit
			"We're ascending beyond the sound barrier with this one [i/s1:2701][i/s1:2701][i/s1:2701]"
			'''
	}
}

