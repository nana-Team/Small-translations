	}

	BadApple: {
		DisplayName: Плохое яблоко
		Tooltip:
			'''
			'Яблоко, упавшее с дерева во время очередной вспышки ярости Гузмы.
			По всей видимости, оно превратилось во что-то совершенно иное и, вероятно, ужасное на вкус.
			Да даже если оно окажется нормальным, запах всё равно удручает.'
			'''
	}

	CometKunai: {
		DisplayName: Кометный кунай
		Tooltip:
			'''
			Запускает залп из кунаев и звёзд, удваивающихся при попаданиях по врагам
			При скрытом ударе заряжает шар, вызывающий звёздный дождь при столкновении
			'Мощь солнца... у меня в руках.'
			'''
			# Доктор Октавиус, Человек-паук 2
	}

	GoopHairDye: {
		DisplayName: Липкая краска для волос
