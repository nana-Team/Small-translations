		Tooltip: Стреляет в основном безвредным всплеском слизи
	}
	
	Parasanguine: {
		DisplayName: Парасангвин
		Tooltip:
			'''
			Удерживание <left> и атаки по врагам накапливают шкалу кровоизбытка
			Нажмите <right> с полной шкалой, чтобы выбросить избыток
			Нажмите <left> после атаки <right>, чтобы совершить атаку сокрушающим вихрем
			'Что получится, если накормить слизня? Слизень побольше'
			'''
	}

	Gobflogger: {
		DisplayName: Сгусткохлёст
		Tooltip:
			'''
			{$CommonItemTooltip.SummonTagDamage}
			{$CommonItemTooltip.Whips}
			Атаки по врагам немного увеличивают скорость атаки
			'Поспешишь - людей насмешишь'
			'''
	}
	
	CrystalGauntlets: {
		DisplayName: Кристальные рукавицы
		Tooltip:
			'''
			Удерживайте <left>, чтобы зарядить мощный взрыв шаровой молнии
			При полном заряде, отпустите <left>, чтобы выпустить шар на своих врагов
			Нажмите <right>, чтобы сделать хлопок и взорвать все выпущенные шаровые молнии
			'Абсолютная власть!'
			'''
			# Палпатин, Звёздные воины
	}

	SplendorJam: {
		DisplayName: Великолепный джем
		Tooltip:
			'''
			Активирует шкалу стресса
			Пассивно накапливает стресс; скорость накопления увеличивается при нахождении рядом с врагами
			Вы излучаете свет, сила которого зависит от вашего уровня стресса
			Призывает по одной Спектакле на 0%, 25%, 50%, 75% и 100% уровня стресса
			При 25% уровня стресса ваше оружие будет создавать взрывы
			При 75% уровня стресса сила и размер этих взрывов увеличатся
			Двойное нажатие ВНИЗ при уровне стресса выше 25% активирует режим злобы
			Режим злобы значительно увеличивает ваш урон, пробивание брони, шанс критического удара, а также дополнительно увеличивает урон на фиксированное значение
			Эффекты и их длительность зависят от вашего уровня стресса
			'Что-то приближается...'
			'''
			# Отсылка на старое сообщение о появлении босса в каламити, взято из старого перевода тру
		StressBar: Стресс: {0}
	}

	SludgeShaker: {
		DisplayName: Слякотный шейк
		Tooltip:
			'''
			Выпускает густой раствор липкой слизи
			Слизь прилипает к поверхностям и другой выпущенной слизи
			'Взболтать, но не смешивать'
