Configs: {
	CompatConfig: {
		DisplayName: Клиентские настройки

		DrawEnabledModListOnMainMenu: {
			Label: Показывать список включённых модов в главном меню
			Tooltip: Определяет, будет ли отображаться список включённых модов в главном меню.
		}

		EnabledModListShowVersions: {
			Label: Показывать версию модов в списке включённых модов
			Tooltip: Определяет, будет ли отображаться версия каждого мода в списке включённых модов.
		}

		ShowRecommendedFixes: {
			Label: Рекомендуемые совместимые моды
			Tooltip: Показывает названия предлагаемых модов для исправления проблем совместимости, обнаруженных при проверке.
		}

		ShowModDonationLink: {
			Label: Показывать ссылку на донат
			Tooltip: Определяет, будет ли отображаться ссылка на донат разработчику мода в панели информации мода.
		}

		DisplayGitHubIssues: {
			Label: Показывать проблемы с GitHub
			Tooltip:
				'''
				Определяет, будут ли отображаться соответствующие проблемы с GitHub, связанные с обнаруженными проблемами совместимости.
				[c/F2A754:Для разработчиков модов и более продвинутых пользователей]
				'''
		}

		ListLocalMods: {
			Label: Список локальных модов
			Tooltip:
				'''
				Определяет, будут ли отображаться локальные моды (не из Мастерской Steam) в меню списка модов.
				[c/F2A754:Для разработчиков модов и более продвинутых пользователей]
				'''
		}

		Headers: {
			Preferences: Параметры
			DeveloperOptions: Для разработчиков [c/F2A754:(расширенные)]
			Checks: Включённые проверки
		}

		CheckMultiplayerCompat: {
			Label: Поддержка мультиплеера
			Tooltip: Проверяет совместимость модов с режимом мультиплеера.
		}
	}
}

Errors: {
	Maintenance:
		'''
		В настоящее время на сервере проводятся технические работы!
		Пожалуйста, повторите попытку позже.
		'''
	Unknown:
		'''
		Сервер временно недоступен или произошла ошибка соединения.
		Пожалуйста, повторите попытку позже.
		'''
}

UI: {
	EnabledMods: "[c/99E550:Включённые моды:] [c/A49DAE:(добавлено Compatibility Checker)]"
	MoreMods: ... и ещё {0} [c/A49DAE:(зажмите Shift, чтобы развернуть список)]
	LocalModDescriptor: " [c/A49DAE:(локальный)]"
	BackToMainMenuButton: Вернуться в главное меню
	BackToMainMenuTooltip: Нажмите, чтобы быстро вернуться в главное меню
	HelpContributeButton: Нажмите, чтобы помочь в сборе данных ⛬
