Buffs: {
	AlluringSong: {
		DisplayName: Чарующая песня
		Description:
			'''
			50% увеличения скорости восстановления вдохновения и радиуса действия ваших усилений
			Симфонические усиления дляться на 5 секунд дольше
			Получение урона восстановит 200 ед. здоровья, но снимет с вас бафф
			«Чтобы цеплять элементальных чикс»
			'''
	}

	AlluringSongCD: {
		DisplayName: Перезарядка «Чарующей песни»
		Description:
			'''
			Вы не можете использовать «Чарующую песню»
			«Never cook again»
			'''
	}

	CalamityBell: {
		DisplayName: Calamity Bell
		Description: It's just waiting there, menacingly...
	}
}

Configs: {
	BalanceConfig: {
		DisplayName: Настройки баланса

		expensiveDraedonsForge: {
			Label: Expensive Draedon's Forge
			Tooltip: Draedon's Forge requires rare Thorium materials to be crafted
		}

		rogueThrowerMerge: {
			Label: Объединить класса разбойника и метателя
			Tooltip: Мод Ragnarok будет автоматически отключаться
		}

		bard: {
			Label: Множитель урона оружия барда
			Tooltip:
				'''
				Умножает урон симфонического оружия на указанное значение
				(Для применения эффекта потребуется перезагрузить мир!)
				'''
		}

		radiant: {
			Label: Множитель урона оружия целителя
			Tooltip:
				'''
				Умножает урон лучезарного оружия на указанное значение
				(Для применения эффекта потребуется перезагрузить мир!)
				'''
		}

		soulEssence: {
			Label: Множитель субстанции души
			Tooltip:
				'''
				Умножает получаемое количество субстанций души атакующего оружия целителя на указанное значение
				Это значение не может превышать 5 ед.
				(Для применения эффекта потребуется перезагрузить мир!)
				'''
		}

		healing: {
			Label: Множитель исцеления
			Tooltip:
				'''
				Умножает количество исцеления от исцеляющих заклинаний
				При значении, установленном на 0, будет исцеляться только 1 ед. здоровья
				(Для применения эффекта потребуется перезагрузить мир!)
				'''
		}
	}
}
